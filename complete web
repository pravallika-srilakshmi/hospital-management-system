    <!-- Hero Section -->
    <section id="home" class="hero-section">
      <div class="container hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span>✨</span> Next-Generation Hospital Management
          </div>
          <h1>Smart Healthcare Management, <span>All in One Place.</span></h1>
          <p>
            Connect with certified doctors, manage appointments, access verified medical records, laboratory reports,
            digital prescriptions, billing and 24/7 hospital services through one unified, secure platform.
          </p>
          <div class="hero-buttons">
            <button class="btn btn-primary btn-lg" onclick="app.openBookingWizard()">📅 Book Appointment</button>
            <a href="#emergency" class="btn btn-danger btn-lg">🚨 24/7 Emergency Care</a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-main-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
              <div style="display:flex; align-items:center; gap:12px;">
                <div class="brand-icon" style="width:38px; height:38px; font-size:1.1rem;">🏥</div>
                <div>
                  <h4 style="font-size:1.05rem;">V MediCare Center</h4>
                  <p style="font-size:0.75rem; color:var(--text-muted);">NABH & JCI Accredited Super Specialty</p>
                </div>
              </div>
              <span class="badge badge-success">● Hospital Live</span>
            </div>
            <div style="background:var(--bg-subtle); padding:16px; border-radius:var(--radius-md); margin-bottom:16px;">
              <div style="display:flex; justify-content:space-between; font-size:0.85rem; margin-bottom:6px;">
                <span>Doctor OPD Availability</span>
                <b>94% Active</b>
              </div>
              <div class="bed-progress-bar" style="margin:0;">
                <div class="bed-progress-fill" style="width: 94%;"></div>
              </div>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; font-size:0.85rem;">
              <div style="background:#eff6ff; padding:12px; border-radius:var(--radius-md);">
                <div style="color:var(--secondary); font-weight:700;">Diagnostic Lab</div>
                <div>24/7 Sample Collection</div>
              </div>
              <div style="background:#ecfdf5; padding:12px; border-radius:var(--radius-md);">
                <div style="color:#059669; font-weight:700;">Pharmacy</div>
                <div>Full Stock & Dispense</div>
              </div>
            </div>
          </div>

          <div class="floating-stat-card top-right">
            <div style="font-size:1.8rem;">👨‍⚕️</div>
            <div>
              <h5 style="font-size:1.1rem; color:var(--primary);">50+ Doctors</h5>
              <p style="font-size:0.75rem; color:var(--text-muted);">Super Specialists</p>
            </div>
          </div>

          <div class="floating-stat-card bottom-left">
            <div style="font-size:1.8rem;">🚑</div>
            <div>
              <h5 style="font-size:1.1rem; color:var(--danger);">24/7 Emergency</h5>
              <p style="font-size:0.75rem; color:var(--text-muted);">Live ACLS Ambulances</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Statistics Section -->
    <section class="stats-section">
      <div class="container stats-grid">
        <div class="stat-item">
          <h3>50+</h3>
          <p>Specialist Doctors</p>
        </div>
        <div class="stat-item">
          <h3>20+</h3>
          <p>Clinical Departments</p>
        </div>
        <div class="stat-item">
          <h3>10,000+</h3>
          <p>Treated Patients</p>
        </div>
        <div class="stat-item">
          <h3>24/7</h3>
          <p>Emergency & Trauma Care</p>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="section section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Clinical Excellence</span>
          <h2 class="section-title">Comprehensive Hospital Services</h2>
          <p class="section-subtitle">Delivering precision clinical care, advanced diagnostics, and compassionate
            healthcare solutions for all age groups.</p>
        </div>
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon">🚨</div>
            <h4>Emergency Care</h4>
            <p>24/7 specialized trauma center equipped with resuscitation suites and triage protocols.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🩺</div>
            <h4>Doctor Consultation</h4>
            <p>Multi-specialty outpatient clinics featuring seasoned senior consultants across medicine and surgery.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🧪</div>
            <h4>Diagnostic Laboratory</h4>
            <p>Fully automated pathology, biochemistry, and microbiology diagnostics with online reports.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">💊</div>
            <h4>24/7 Pharmacy</h4>
            <p>Round-the-clock dispensing of branded medicines, injectables, and surgical consumables.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🛏️</div>
            <h4>Intensive Care (ICU)</h4>
            <p>High-tech intensive therapy units equipped with advanced ventilators and cardiac monitors.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🚑</div>
            <h4>Ambulance Services</h4>
            <p>Fleet of ACLS vehicles on standby with paramedic emergency personnel and GPS routing.</p>
          </div>
          <div class="service-card">
            <div class="service-icon">🔬</div>
            <h4>Surgical Care</h4>
            <p>Laminar airflow modular operation theatres for laparoscopic, orthopedic, and cardiovascular surgeries.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon">❤️</div>
            <h4>Health Checkups</h4>
            <p>Tailored preventive screening packages including cardiac profiles and comprehensive wellness panels.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Departments Section -->
    <section id="departments" class="section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Specialized Wings</span>
          <h2 class="section-title">Hospital Departments</h2>
          <p class="section-subtitle">Explore our specialized clinical centers of excellence supported by renowned
            medical professors and surgeons.</p>
        </div>
        <div id="departments-grid-target" class="dept-grid"></div>
      </div>
    </section>

    <!-- Doctors Section -->
    <section id="doctors" class="section section-alt">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Medical Faculty</span>
          <h2 class="section-title">Consult Our Specialists</h2>
          <p class="section-subtitle">Book appointments with leading surgeons, cardiologists, pediatricians, and
            physicians.</p>
        </div>
        <div id="doctors-grid-target" class="doctors-grid"></div>
      </div>
    </section>

    <!-- Emergency Section -->
    <section id="emergency" class="section">
      <div class="container">
        <div class="emergency-hub">
          <div class="emergency-hub-grid">
            <div>
              <span class="badge" style="background:rgba(255,255,255,0.25); color:#ffffff; margin-bottom:12px;">CRITICAL
                RESPONSE 24/7</span>
              <h2>V MediCare Emergency & Trauma Centre</h2>
              <p>Our emergency department operates round-the-clock with trauma resuscitation surgeons, stroke
                specialists, and critical care nursing staff.</p>
              <div class="emergency-hotline">
                <span style="font-size:1.8rem;">📞</span>
                <div>
                  <div style="font-size:0.8rem; text-transform:uppercase; letter-spacing:1px;">Toll-Free Emergency
                    Hotline</div>
                  <div class="number">1800-200-9999</div>
                </div>
              </div>
              <div>
                <button class="btn btn-primary"
                  onclick="alert('Connecting to V MediCare Dispatch Operator: 1800-200-9999')">📞 Call Emergency
                  Now</button>
              </div>
            </div>
            <div class="ambulance-tracker-card">
              <h4>
                <span>🚑 Live Ambulance Fleet Status</span>
                <span class="badge badge-success">GPS Active</span>
              </h4>
              <div id="ambulance-list-target" class="ambulance-status-list"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer id="contact" class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <h3>✚ V MediCare</h3>
            <p>A premier multi-specialty healthcare institution and smart hospital management platform dedicated to
              delivering world-class clinical outcomes, paperless medical records, and compassionate healthcare.</p>
          </div>
          <div class="footer-col">
            <h4>Quick Links</h4>
            <ul class="footer-links">
              <li><a href="#home">Home</a></li>
              <li><a href="#services">Services</a></li>
              <li><a href="#departments">Departments</a></li>
              <li><a href="#doctors">Consultant Doctors</a></li>
              <li><a href="#emergency">Emergency Care</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Portals & Roles</h4>
            <ul class="footer-links">
              <li><a href="javascript:void(0)" onclick="app.openLoginModal('patient')">Patient Portal</a></li>
              <li><a href="javascript:void(0)" onclick="app.openLoginModal('doctor')">Doctor Clinical Desk</a></li>
              <li><a href="javascript:void(0)" onclick="app.openLoginModal('receptionist')">Front Desk & Beds</a></li>
              <li><a href="javascript:void(0)" onclick="app.openLoginModal('pharmacist')">Pharmacy Operations</a></li>
              <li><a href="javascript:void(0)" onclick="app.openLoginModal('labtech')">Diagnostic Lab Console</a></li>
              <li><a href="javascript:void(0)" onclick="app.openLoginModal('admin')">Admin Command Center</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>24/7 Helpline</h4>
            <ul class="footer-links">
              <li>📞 Emergency: 1800-200-9999</li>
              <li>📞 Appointments: +91 80 4455 6677</li>
              <li>✉️ info@vmedicare.com</li>
              <li>📍 MG Road, Bengaluru, Karnataka</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <div>© 2026 V MediCare Hospital Management System. All rights reserved.</div>
          <div>Role-Based Access Control • Electronic Health Records • HIPAA Compliant Architecture</div>
        </div>
      </div>
    </footer>
  </div>

  <!-- AUTHENTICATED DASHBOARD APPLICATION -->
  <div id="dashboard-app" class="dashboard-app">
    <aside class="dash-sidebar">
      <div class="dash-sidebar-header">
        <div class="brand-icon" style="width:34px; height:34px; font-size:1rem;">✚</div>
        <div style="font-weight:800; font-size:1.2rem; color:var(--text-main);">V MediCare</div>
      </div>
      <div class="user-badge-role">
        <div id="dash-user-avatar" class="user-avatar-circle">U</div>
        <div class="user-info-text">
          <h5 id="dash-user-name">User Name</h5>
          <p id="dash-user-role">Role (ID)</p>
        </div>
      </div>
      <ul id="sidebar-menu-target" class="sidebar-nav"></ul>
      <div class="sidebar-footer">
        <button class="btn btn-outline btn-sm" style="width:100%;" onclick="app.logout()">🚪 Sign Out</button>
      </div>
    </aside>

    <div class="dash-main">
      <header class="dash-topbar">
        <div class="dash-title-area">
          <h2 id="dash-header-title">Hospital Portal</h2>
          <p id="dash-header-sub">Role-Based Medical Operations & Clinical Workflow</p>
        </div>
        <div class="dash-topbar-actions">
          <button class="btn btn-outline btn-sm" onclick="app.openSimulatedEmailModal()"
            title="View Sent Transactional Emails">✉️ Email Logs</button>
          <button class="icon-btn" onclick="app.openSimulatedEmailModal()" title="Notifications">🔔<span
              id="dash-unread-badge" class="notification-badge-count">2</span></button>
          <button class="btn btn-outline-primary btn-sm" onclick="app.logout()">Home Page</button>
        </div>
      </header>
      <main class="dash-content">
        <div id="dash-content-target"></div>
      </main>
    </div>
  </div>

  <!-- V MEDICARE AI ASSISTANT WIDGET -->
  <button id="ai-fab-btn" class="ai-fab" title="Chat with V MediCare AI Assistant">🤖</button>
  <div id="ai-chat-window" class="ai-chat-window">
    <div class="ai-chat-header">
      <div class="ai-header-info">
        <div class="ai-avatar">🤖</div>
        <div>
          <h5 style="font-size:0.95rem;">V MediCare Assistant</h5>
          <p style="font-size:0.72rem; opacity:0.9;">Hospital AI Guide</p>
        </div>
      </div>
      <button class="modal-close-btn" style="color:#ffffff;"
        onclick="document.getElementById('ai-chat-window').classList.remove('active')">✕</button>
    </div>
    <div class="ai-disclaimer">
      ⚠️ <b>Medical Disclaimer:</b> This assistant provides hospital information only and does not diagnose conditions
      or replace professional medical advice.
    </div>
    <div id="ai-messages-target" class="ai-messages-area">
      <div class="ai-bubble bot">Hello! I am your <b>V MediCare Assistant</b>. How can I help you today? You can ask me
        about finding doctors, booking appointments, emergency numbers, or hospital timings.</div>
    </div>
    <div class="ai-quick-prompts">
      <button class="ai-prompt-btn" onclick="app.askAIPreset('How do I book an appointment?')">Book Appt</button>
      <button class="ai-prompt-btn" onclick="app.askAIPreset('What is the emergency contact?')">Emergency</button>
      <button class="ai-prompt-btn" onclick="app.askAIPreset('Tell me about Cardiology')">Cardiology</button>
      <button class="ai-prompt-btn" onclick="app.askAIPreset('What are the hospital timings?')">Visiting Hours</button>
    </div>
    <div class="ai-chat-input-area">
      <input type="text" id="ai-user-msg" class="form-control" placeholder="Ask a question..."
        style="font-size:0.85rem;">
      <button id="ai-send-btn" class="btn btn-primary btn-sm">Send</button>
    </div>
  </div>

  <!-- ALL MODALS INCLUDED -->
  <div id="login-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">V MediCare Secure Portal Login</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <div class="demo-role-selector">
          <p>⚡ 1-Click Demo Login (CSE Reviewer Shortcut):</p>
          <div class="demo-pills">
            <button type="button" class="demo-pill" onclick="app.populateDemoCredentials('patient')">👤 Patient</button>
            <button type="button" class="demo-pill" onclick="app.populateDemoCredentials('doctor')">👨‍⚕️
              Doctor</button>
            <button type="button" class="demo-pill" onclick="app.populateDemoCredentials('receptionist')">🏨
              Receptionist</button>
            <button type="button" class="demo-pill" onclick="app.populateDemoCredentials('pharmacist')">💊
              Pharmacist</button>
            <button type="button" class="demo-pill" onclick="app.populateDemoCredentials('labtech')">🧪 Lab
              Tech</button>
            <button type="button" class="demo-pill" onclick="app.populateDemoCredentials('admin')">🛡️ Admin</button>
          </div>
        </div>
        <form
          onsubmit="event.preventDefault(); app.loginUser(document.getElementById('login-email').value, document.getElementById('login-password').value);">
          <div class="form-group"><label class="form-label">Email Address</label><input type="email" id="login-email"
              class="form-control" required placeholder="name@vmedicare.com"></div>
          <div class="form-group"><label class="form-label">Password</label><input type="password" id="login-password"
              class="form-control" required placeholder="••••••••"></div>
          <div
            style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; font-size:0.85rem;">
            <label><input type="checkbox" checked> Remember Me</label><a href="javascript:void(0)"
              onclick="alert('Password reset link sent to registered email!')">Forgot Password?</a></div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Secure Log In</button>
        </form>
        <div style="text-align:center; margin-top:16px; font-size:0.88rem;">Don't have a Patient account? <a
            href="javascript:void(0)" onclick="app.openRegisterModal()" style="font-weight:700;">Register as Patient</a>
        </div>
      </div>
    </div>
  </div>

  <div id="register-modal" class="modal-overlay">
    <div class="modal-container modal-lg">
      <div class="modal-header">
        <h3 class="modal-title">New Patient Registration</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.registerPatient({ name: this.reg_name.value, email: this.reg_email.value, phone: this.reg_phone.value, dob: this.reg_dob.value, gender: this.reg_gender.value, bloodGroup: this.reg_blood.value, address: this.reg_address.value, emergencyContact: this.reg_emergency.value, password: this.reg_password.value });">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Full Name</label><input type="text" name="reg_name"
                class="form-control" required placeholder="e.g. Ramesh Patel"></div>
            <div class="form-group"><label class="form-label">Email Address</label><input type="email" name="reg_email"
                class="form-control" required placeholder="ramesh@gmail.com"></div>
          </div>
          <div class="form-row-3">
            <div class="form-group"><label class="form-label">Date of Birth</label><input type="date" name="reg_dob"
                class="form-control" required></div>
            <div class="form-group"><label class="form-label">Gender</label><select name="reg_gender"
                class="form-control" required>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select></div>
            <div class="form-group"><label class="form-label">Blood Group</label><select name="reg_blood"
                class="form-control">
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
              </select></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Phone</label><input type="tel" name="reg_phone"
                class="form-control" required placeholder="+91 98765 43210"></div>
            <div class="form-group"><label class="form-label">Emergency Contact</label><input type="tel"
                name="reg_emergency" class="form-control" placeholder="+91 98765 00000"></div>
          </div>
          <div class="form-group"><label class="form-label">Address</label><input type="text" name="reg_address"
              class="form-control" required placeholder="Street, City, State"></div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Password</label><input type="password" name="reg_password"
                class="form-control" required placeholder="••••••••"></div>
            <div class="form-group"><label class="form-label">Confirm Password</label><input type="password"
                class="form-control" required placeholder="••••••••"></div>
          </div>
          <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">Complete Registration</button>
        </form>
      </div>
    </div>
  </div>

  <div id="register-success-modal" class="modal-overlay">
    <div class="modal-container" style="text-align:center;">
      <div class="modal-body" style="padding:40px 30px;">
        <div style="font-size:3.5rem; margin-bottom:12px;">🎉</div>
        <h3 style="font-size:1.6rem; color:#059669; margin-bottom:8px;">Registration Successful!</h3>
        <div
          style="background:var(--bg-subtle); border:2px dashed var(--primary-light); padding:20px; border-radius:var(--radius-lg); margin:20px 0;">
          <div style="font-size:0.85rem; color:var(--text-muted);">Assigned Unique Patient ID</div>
          <div id="success-patient-id" style="font-size:2rem; font-weight:800; color:var(--primary);">PAT20260002</div>
          <div style="font-size:0.85rem; margin-top:8px;">Name: <b id="success-patient-name">Patient Name</b></div>
        </div>
        <p style="font-size:0.88rem; color:var(--text-muted); margin-bottom:24px;">Your Patient ID has been sent to <b
            id="success-patient-email">email</b>.</p>
        <button class="btn btn-primary btn-lg" style="width:100%;"
          onclick="app.closeAllModals(); app.openLoginModal('patient');">Proceed to Login</button>
      </div>
    </div>
  </div>

  <!-- Clinical Modals -->
  <div id="medical-record-modal" class="modal-overlay">
    <div class="modal-container modal-lg">
      <div class="modal-header">
        <h3 class="modal-title">Clinical Record</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.addMedicalRecord({ patientId: this.m_pid.value, patientName: this.m_pname.value, diagnosis: this.m_diagnosis.value, symptoms: this.m_symptoms.value, treatmentPlan: this.m_plan.value, vitals: { bp: this.m_bp.value, pulse: this.m_pulse.value, temp: this.m_temp.value, weight: '70kg' }, notes: this.m_notes.value });">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Patient ID</label><input type="text" name="m_pid"
                class="form-control" value="PAT20260001" required></div>
            <div class="form-group"><label class="form-label">Patient Name</label><input type="text" name="m_pname"
                class="form-control" value="Ramesh Patel" required></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">BP</label><input type="text" name="m_bp"
                class="form-control" value="130/85"></div>
            <div class="form-group"><label class="form-label">Pulse</label><input type="text" name="m_pulse"
                class="form-control" value="76"></div>
          </div>
          <div class="form-group"><label class="form-label">Diagnosis</label><input type="text" name="m_diagnosis"
              class="form-control" required value="Mild Hypertension"></div>
          <div class="form-group"><label class="form-label">Treatment Plan</label><textarea name="m_plan"
              class="form-control" rows="2">Low sodium diet, brisk walking.</textarea></div>
          <div class="form-group"><label class="form-label">Clinical Notes</label><input type="text" name="m_notes"
              class="form-control" value="Follow-up in 2 weeks"></div><button type="submit" class="btn btn-primary"
            style="width:100%;">Save Record</button>
        </form>
      </div>
    </div>
  </div>

  <div id="prescription-modal" class="modal-overlay">
    <div class="modal-container modal-lg">
      <div class="modal-header">
        <h3 class="modal-title">Prescription</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.addPrescription({ patientId: document.getElementById('rx-patient-id').value, patientName: document.getElementById('rx-patient-name').value, diagnosis: this.rx_diag.value, items: [{ medicine: this.rx_m1.value, dosage: '1 Tab', frequency: 'Once daily', duration: '30 Days', instructions: 'After breakfast' }] });">
          <input type="hidden" id="rx-patient-id"><input type="hidden" id="rx-patient-name">
          <div class="form-group"><label class="form-label">Diagnosis</label><input type="text" name="rx_diag"
              class="form-control" value="Hypertension" required></div>
          <div class="form-group"><label class="form-label">Medicine</label><input type="text" name="rx_m1"
              class="form-control" value="Telmisartan 40mg" required></div><button type="submit" class="btn btn-primary"
            style="width:100%;">Issue Prescription</button>
        </form>
      </div>
    </div>
  </div>

  <div id="lab-order-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">Order Lab Test</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.requestLabTest({ patientId: document.getElementById('lab-order-patient-id').value, patientName: document.getElementById('lab-order-patient-name').value, testType: this.lab_test_type.value, fee: 450 });">
          <input type="hidden" id="lab-order-patient-id"><input type="hidden" id="lab-order-patient-name">
          <div class="form-group"><label class="form-label">Test</label><select name="lab_test_type"
              class="form-control">
              <option value="Complete Blood Count (CBC)">Complete Blood Count (CBC)</option>
              <option value="Fasting Blood Sugar (FBS)">Fasting Blood Sugar (FBS)</option>
              <option value="12-Lead ECG">12-Lead ECG</option>
            </select></div><button type="submit" class="btn btn-primary" style="width:100%;">Send Lab Order</button>
        </form>
      </div>
    </div>
  </div>

  <div id="lab-result-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">Enter Lab Findings</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <p id="lab-result-patient-info"></p>
        <form
          onsubmit="event.preventDefault(); app.completeLabTest(document.getElementById('lab-result-test-id').value, [{ parameter: 'Analyte Value', value: '120', unit: 'mg/dL', normalRange: '70-140', status: 'Normal' }], this.lab_findings.value);">
          <input type="hidden" id="lab-result-test-id">
          <div class="form-group"><label class="form-label">Findings</label><textarea name="lab_findings"
              class="form-control" required>Report verified by pathology specialist.</textarea></div><button
            type="submit" class="btn btn-primary" style="width:100%;">Publish Lab Report</button>
        </form>
      </div>
    </div>
  </div>

  <div id="lab-view-modal" class="modal-overlay">
    <div class="modal-container modal-lg">
      <div class="modal-header">
        <h3 class="modal-title">Laboratory Diagnostic Report</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body" id="lab-view-content"></div>
      <div class="modal-footer"><button class="btn btn-primary" onclick="window.print()">🖨️ Print
          Report</button><button class="btn btn-outline" onclick="app.closeAllModals()">Close</button></div>
    </div>
  </div>

  <div id="medicine-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">Enroll Medicine</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.addOrUpdateMedicine({ name: this.med_name.value, category: this.med_cat.value, stock: Number(this.med_stock.value), minStock: Number(this.med_min.value), price: Number(this.med_price.value), expiry: this.med_expiry.value, supplier: this.med_sup.value });">
          <div class="form-group"><label class="form-label">Medicine Name</label><input type="text" name="med_name"
              class="form-control" required value="Amoxicillin 500mg"></div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Category</label><input type="text" name="med_cat"
                class="form-control" value="Antibiotics"></div>
            <div class="form-group"><label class="form-label">Supplier</label><input type="text" name="med_sup"
                class="form-control" value="Alkem Labs"></div>
          </div>
          <div class="form-row-3">
            <div class="form-group"><label class="form-label">Stock</label><input type="number" name="med_stock"
                class="form-control" value="100"></div>
            <div class="form-group"><label class="form-label">Min</label><input type="number" name="med_min"
                class="form-control" value="25"></div>
            <div class="form-group"><label class="form-label">Price (₹)</label><input type="number" name="med_price"
                class="form-control" value="80"></div>
          </div>
          <div class="form-group"><label class="form-label">Expiry</label><input type="month" name="med_expiry"
              class="form-control" value="2027-08"></div><button type="submit" class="btn btn-primary"
            style="width:100%;">Save Medicine</button>
        </form>
      </div>
    </div>
  </div>

  <div id="staff-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">Enroll Staff Member</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.addStaffMember({ name: this.stf_name.value, email: this.stf_email.value, role: this.stf_role.value, department: this.stf_dept.value, phone: this.stf_phone.value, specialty: 'General', experience: '5 Years', fee: 600 });">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Name</label><input type="text" name="stf_name"
                class="form-control" required placeholder="Full Name"></div>
            <div class="form-group"><label class="form-label">Role</label><select name="stf_role" class="form-control">
                <option value="doctor">Doctor</option>
                <option value="receptionist">Receptionist</option>
                <option value="pharmacist">Pharmacist</option>
                <option value="labtech">Lab Tech</option>
              </select></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Email</label><input type="email" name="stf_email"
                class="form-control" required placeholder="staff@vmedicare.com"></div>
            <div class="form-group"><label class="form-label">Department</label><input type="text" name="stf_dept"
                class="form-control" value="Cardiology"></div>
          </div>
          <div class="form-group"><label class="form-label">Phone</label><input type="text" name="stf_phone"
              class="form-control" placeholder="+91 98..."></div><button type="submit" class="btn btn-primary"
            style="width:100%;">Create Staff Account</button>
        </form>
      </div>
    </div>
  </div>

  <div id="bill-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">Generate Invoice</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <form
          onsubmit="event.preventDefault(); app.createBill({ patientId: this.b_pid.value, patientName: this.b_pname.value, consultationFee: this.b_cons.value, roomCharges: 0, labCharges: 400, medicineCharges: 150, treatmentCharges: 0 });">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Patient ID</label><input type="text" name="b_pid"
                class="form-control" value="PAT20260001"></div>
            <div class="form-group"><label class="form-label">Patient Name</label><input type="text" name="b_pname"
                class="form-control" value="Ramesh Patel"></div>
          </div>
          <div class="form-group"><label class="form-label">Consultation Fee (₹)</label><input type="number"
              name="b_cons" class="form-control" value="800"></div><button type="submit" class="btn btn-primary"
            style="width:100%;">Generate Bill</button>
        </form>
      </div>
    </div>
  </div>

  <div id="payment-modal" class="modal-overlay">
    <div class="modal-container">
      <div class="modal-header">
        <h3 class="modal-title">Pay Bill</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body"><input type="hidden" id="pay-bill-id">
        <div
          style="text-align:center; padding:16px; background:var(--primary-subtle); border-radius:var(--radius-md); margin-bottom:14px;">
          <div id="pay-bill-amount" style="font-size:2rem; font-weight:800; color:var(--primary);">₹0</div>
          <div id="pay-bill-patient">Patient</div>
        </div><button class="btn btn-success btn-lg" style="width:100%;"
          onclick="app.payBill(document.getElementById('pay-bill-id').value, 'Mock Online Payment')">Confirm Instant
          Payment</button>
      </div>
    </div>
  </div>

  <div id="invoice-modal" class="modal-overlay">
    <div class="modal-container modal-lg">
      <div class="modal-header no-print">
        <h3 class="modal-title">Tax Invoice</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body printable-area" id="invoice-print-area"></div>
      <div class="modal-footer no-print"><button class="btn btn-primary" onclick="window.print()">🖨️
          Print</button><button class="btn btn-outline" onclick="app.closeAllModals()">Close</button></div>
    </div>
  </div>

  <div id="email-hub-modal" class="modal-overlay">
    <div class="modal-container modal-lg">
      <div class="modal-header">
        <h3 class="modal-title">✉️ Transactional Email Dispatch Logs</h3><button class="modal-close-btn">✕</button>
      </div>
      <div class="modal-body">
        <div id="email-list-target"></div>
      </div>
    </div>
  </div>

  <script src="app.js"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>V MediCare — Smart Healthcare Management Platform</title>
  <meta name="description"
    content="V MediCare is an advanced full-stack hospital management system featuring role-based dashboards, appointment booking, medical records, laboratory diagnostic tracking, digital pharmacy, bed occupancy, and AI health assistance.">
  <link rel="stylesheet" href="styles.css">
</head>

<body>

  <!-- Toast Notification Hub -->
  <div id="toast-container" class="toast-container"></div>

  <!-- PUBLIC LANDING PAGE VIEW -->
  <div id="landing-view">
    <header class="landing-nav">
      <div class="container nav-wrapper">
        <a href="#home" class="brand-logo">
          <div class="brand-icon">✚</div>
          <div>V MediCare</div>
        </a>

        <ul class="nav-links">
          <li><a href="#home" class="active">Home</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#departments">Departments</a></li>
          <li><a href="#doctors">Doctors</a></li>
          <li><a href="#emergency">Emergency</a></li>
          <li><a href="#contact">Contact</a></li>
